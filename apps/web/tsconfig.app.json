{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // vite/client declares `*.css` and friends; allowArbitraryExtensions would instead
    // make TypeScript look for a main.d.css.ts next to every stylesheet.
    "types": ["vite/client"],

    // No baseUrl: it is deprecated in TypeScript 6 and removed in 7.
    // Without it, `paths` resolves relative to this file, which is what we want.
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Strictness beyond @vue/tsconfig defaults */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.d.ts"]
}
