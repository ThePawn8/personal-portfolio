# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — it is gitignored.
# Every variable the applications read must be listed here with a safe default.
# ---------------------------------------------------------------------------

# --- API: runtime -----------------------------------------------------------
APP_ENV=local                       # local | preview | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_PORT=8000

# --- API: database ----------------------------------------------------------
# Matches infra/docker-compose.yml: the least-privilege app user, not root.
# These credentials are local-only and intentionally not secret.
MONGODB_URI=mongodb://portfolio:local-dev-only@localhost:27017/portfolio?authSource=portfolio
MONGODB_DB=portfolio

# --- API: CORS --------------------------------------------------------------
# Comma-separated exact origins. Never use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- API: contact form ------------------------------------------------------
# Leave RESEND_API_KEY empty locally: email sending becomes a logged no-op.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=portfolio@example.com
CONTACT_RATE_LIMIT_PER_HOUR=5

# Salt used to hash visitor IP addresses for rate limiting.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=change-me-to-a-random-64-char-hex-string

# --- Web --------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:5173
